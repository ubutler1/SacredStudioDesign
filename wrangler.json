{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uriel-alexander-studio",
  "main": "worker/contact.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-cloudflare.cjs"
  },
  "assets": {
    "directory": "./cloudflare-dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/inquiry",
      "/thank-you",
      "/thank-you.html",
      "/thank-you/",
      "/contact",
      "/contact.html",
      "/contact/"
    ]
  },
  "vars": {
    "INQUIRIES_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "INQUIRY_LIMITER",
      "namespace_id": "2026110401",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "urielalexanderstudio.com",
      "custom_domain": true
    },
    {
      "pattern": "www.urielalexanderstudio.com",
      "custom_domain": true
    }
  ],
  "send_email": [
    {
      "name": "INQUIRY_EMAIL",
      "destination_address": "urielalexanderstudio@gmail.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "INQUIRIES_DB",
      "database_name": "uriel-studio-inquiries",
      "database_id": "04a10c92-5e4c-46f8-86a5-8eb4dd2f24c2",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}
