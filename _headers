/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

# Advertising endpoints are blocked on inquiry and privacy routes as a second
# layer alongside the consent loader. Inline hosting UI remains compatible.
/contact*
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests; script-src 'self'; connect-src 'self'; img-src 'self' data:; frame-src 'self'
  Cache-Control: no-store
/thank-you*
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests; script-src 'self'; connect-src 'self'; img-src 'self' data:; frame-src 'self'
  Cache-Control: no-store
  X-Robots-Tag: noindex
/privacy*
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests; script-src 'self'; connect-src 'self'; img-src 'self' data:; frame-src 'self'
  Cache-Control: no-store

/studio-updates*
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests; script-src 'self'; connect-src 'self'; img-src 'self' data:; frame-src 'self'
  Cache-Control: no-store
/updates-confirmed*
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests; script-src 'self'; connect-src 'self'; img-src 'self' data:; frame-src 'self'
  Cache-Control: no-store
  X-Robots-Tag: noindex

/*
  Strict-Transport-Security: max-age=31536000

# Keep the independent workers.dev copy out of search results.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex

https://:version.:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
