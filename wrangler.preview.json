{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uriel-studio-inquiries-preview",
  "main": "worker/contact.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-cloudflare.cjs"
  },
  "assets": {
    "directory": "./cloudflare-dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/inquiry",
      "/thank-you",
      "/thank-you.html",
      "/thank-you/",
      "/contact",
      "/contact.html",
      "/contact/"
    ]
  },
  "vars": {
    "INQUIRIES_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "INQUIRY_LIMITER",
      "namespace_id": "2026110402",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "routes": [],
  "send_email": [
    {
      "name": "INQUIRY_EMAIL",
      "destination_address": "urielalexanderstudio@gmail.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "INQUIRIES_DB",
      "database_name": "uriel-studio-inquiries-test",
      "database_id": "c72415e4-b5e2-4e37-bbd4-a2f6e3533e8d",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": []
  }
}
